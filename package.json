{
  "name": "gitx",
  "version": "1.0.0",
  "description": "Extended Git Operations CLI",
  "type": "module",
  "bin": {
    "gitx": "./dist/index.js"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "build": "pnpm quality && pnpm build-package",
    "build-ci": "./scripts/quality-build.sh && pnpm build-package",
    "build-package": "tsup src/index.ts --format esm --clean --dts",
    "dev": "tsx src/index.ts",
    "lint:fix": "biome check --fix .",
    "lint": "biome check .",
    "preinstall": "npx only-allow pnpm",
    "quality": "./scripts/quality-dev.sh",
    "release": "changeset publish",
    "reqcheck": "gherkin-lint requirements/",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "citty": "catalog:",
    "execa": "catalog:",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "gherkin-lint": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  }
}
